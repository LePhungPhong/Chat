// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageStatus {
  show
  recall
  delete
  sent
}

enum MessageType {
  text
  file
}

enum FileType {
  image
  video
  file
  audio
}

model Users {
  id        String  @id @default(uuid())
  username  String  @unique
  fullname  String?
  avatarUrl String? @default("https://i.pinimg.com/736x/c6/e5/65/c6e56503cfdd87da299f72dc416023d4.jpg")

  sentMessages          Message[]              @relation("SentMessages")
  conversationMembers   ConversationMember[]
  readReceipts          ReadReceipt[]
  typingStatuses        TypingStatus[]
  videoCallRooms        VideoCallRoom[]        @relation("UserVideoCallRooms")
  // (tuỳ chọn) tham gia phòng call:
  videoCallParticipants VideoCallParticipant[]
}

model Conversation {
  id         String    @id @default(uuid())
  is_group   Boolean   @default(false)
  name       String?
  created_by String?
  created_at DateTime?

  members      ConversationMember[]
  messages     Message[]
  typingStatus TypingStatus[]
}

model ConversationMember {
  conversation_id      String
  user_id              String
  joined_at            DateTime?
  last_read_message_id String?

  conversation    Conversation @relation(fields: [conversation_id], references: [id])
  user            Users        @relation(fields: [user_id], references: [id])
  lastReadMessage Message?     @relation("LastReadMessage", fields: [last_read_message_id], references: [id])

  @@id([conversation_id, user_id])
}

model Message {
  id              String        @id @default(uuid())
  conversation_id String
  sender_id       String
  status          MessageStatus @default(show)
  message         String
  message_type    MessageType
  created_at      DateTime      @default(now())
  updated_at      DateTime      @default(now())

  conversation Conversation         @relation(fields: [conversation_id], references: [id])
  sender       Users                @relation("SentMessages", fields: [sender_id], references: [id])
  attachments  Attachment[]
  readReceipts ReadReceipt[]
  lastReadBy   ConversationMember[] @relation("LastReadMessage")
}

model Attachment {
  id         String    @id @default(uuid())
  message_id String?
  file_url   String
  file_type  FileType?
  created_at DateTime?

  message Message? @relation(fields: [message_id], references: [id])

  @@index([message_id])
}

model TypingStatus {
  conversation_id String
  user_id         String
  is_typing       Boolean   @default(false)
  updated_at      DateTime?

  conversation Conversation @relation(fields: [conversation_id], references: [id])
  user         Users        @relation(fields: [user_id], references: [id])

  @@id([conversation_id, user_id])
}

model ReadReceipt {
  message_id String
  user_id    String
  read_at    DateTime?

  message Message @relation(fields: [message_id], references: [id])
  user    Users   @relation(fields: [user_id], references: [id])

  @@id([message_id, user_id])
  @@index([user_id])
}

model VideoCallRoom {
  id         String   @id @default(uuid())
  room_code  String   @unique
  token      String
  host_id    String
  created_at DateTime @default(now())

  host Users @relation("UserVideoCallRooms", fields: [host_id], references: [id])

  // Quan hệ mới: danh sách người tham gia phòng
  participants VideoCallParticipant[]
}

model VideoCallParticipant {
  id        String    @id @default(uuid())
  room_id   String
  user_id   String
  joined_at DateTime  @default(now())
  left_at   DateTime?

  room VideoCallRoom @relation(fields: [room_id], references: [id])
  user Users         @relation(fields: [user_id], references: [id])

  @@index([room_id])
  @@index([user_id])
}
