
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageStatus {
  show
  recall
  delete
  sent
}

enum MessageType {
  text
  file
}

// ... (Giữ nguyên model Users, Conversation, ConversationMember) ...
model Users {
  id        String   @id @default(uuid())
  username  String   @unique
  fullname  String?
  email     String?
  avatarUrl String?  @default("https://github.com/shadcn.png")
  last_seen DateTime @default(now())
  is_online Boolean  @default(false)
  sentMessages          Message[]              @relation("SentMessages")
  conversationMembers   ConversationMember[]
  readReceipts          ReadReceipt[]
  typingStatuses        TypingStatus[]
  videoCallRooms        VideoCallRoom[]        @relation("UserVideoCallRooms")
  videoCallParticipants VideoCallParticipant[]
}

model Conversation {
  id         String    @id @default(uuid())
  is_group   Boolean   @default(false)
  name       String?
  created_by String?
  created_at DateTime? @default(now())
  members      ConversationMember[]
  messages     Message[]
  typingStatus TypingStatus[]
  videoCallRooms VideoCallRoom[]
}

model ConversationMember {
  conversation_id      String
  user_id              String
  joined_at            DateTime? @default(now())
  last_read_message_id String?
  role                 String?   @default("member")
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user            Users        @relation(fields: [user_id], references: [id])
  lastReadMessage Message?     @relation("LastReadMessage", fields: [last_read_message_id], references: [id])
  
  @@id([conversation_id, user_id])
}

// --- CẬP NHẬT MODEL MESSAGE ---
model Message {
  id              String        @id @default(uuid())
  conversation_id String
  sender_id       String
  status          MessageStatus @default(show)
  message         String
  message_type    MessageType
  created_at      DateTime      @default(now())
  updated_at      DateTime      @default(now()) @updatedAt

  // THÊM: Logic Trả lời tin nhắn
  replyToId       String?
  replyTo         Message?      @relation("ReplyRelation", fields: [replyToId], references: [id])
  replies         Message[]     @relation("ReplyRelation")

  conversation Conversation         @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       Users                @relation("SentMessages", fields: [sender_id], references: [id])
  attachments  Attachment[]
  readReceipts ReadReceipt[]
  lastReadBy   ConversationMember[] @relation("LastReadMessage")
}

model Attachment {
  id         String    @id @default(uuid())
  message_id String?
  file_url   String
  file_type  String?
  created_at DateTime? @default(now())
  message Message? @relation(fields: [message_id], references: [id], onDelete: Cascade)
  @@index([message_id])
}

model TypingStatus {
  conversation_id String
  user_id         String
  is_typing       Boolean   @default(false)
  updated_at      DateTime?
  conversation    Conversation @relation(fields: [conversation_id], references: [id])
  user            Users        @relation(fields: [user_id], references: [id])
  @@id([conversation_id, user_id])
}

model ReadReceipt {
  message_id String
  user_id    String
  read_at    DateTime?
  message    Message   @relation(fields: [message_id], references: [id])
  user       Users     @relation(fields: [user_id], references: [id])
  @@id([message_id, user_id])
  @@index([user_id])
}


model VideoCallRoom {
  id              String   @id @default(uuid())
  room_code       String   @unique
  token           String?  // Có thể bỏ nếu ko dùng token xác thực riêng
  host_id         String
  conversation_id String
  group_name      String?
  status          String   @default("active") // "active" hoặc "ended"
  created_at      DateTime @default(now())
  ended_at        DateTime?

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  host         Users        @relation("UserVideoCallRooms", fields: [host_id], references: [id])
  participants VideoCallParticipant[]
  
  @@index([conversation_id])
}

model VideoCallParticipant {
  id        String    @id @default(uuid())
  room_id   String
  user_id   String
  joined_at DateTime  @default(now())
  left_at   DateTime?
  room      VideoCallRoom @relation(fields: [room_id], references: [id])
  user      Users         @relation(fields: [user_id], references: [id])
  @@index([room_id])
  @@index([user_id])
}